# Port and host for the Fastify server
PORT=8081
HOST=0.0.0.0

# Gemini internal build identifier (fallback provided in code)
# GEMINI_BL=boq_assistant-bard-web-server_20260525.09_p0

# Admin API key for external applications (e.g. LibreChat, NextChat, OpenCode).
# Always accepted by the gateway without rate limits. Default is sk-personal-gw.
ADMIN_API_KEY=sk-personal-gw

# Optional: Google Gemini cookies (fallback checks cookies/cookie.txt)
# GEMINI_COOKIE=SID=...; HSID=...; __Secure-1PSID=...;
